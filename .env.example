# ─── Backend ─────────────────────────────────────────────────────────────────
# Directory where datasets are stored (generated on first run if empty)
SF_DATA_DIR=backend/data

# Directory where trained model files are saved
SF_MODEL_DIR=backend/models

# Path to the compiled Next.js static export served by FastAPI
# (only needed when running the single-server / Docker mode)
SF_FRONTEND_DIST=frontend/out

# Comma-separated list of allowed CORS origins for the API
SF_CORS_ORIGINS=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend used by Next.js dev-server rewrites
# Defaults to http://127.0.0.1:8000 — only override for remote backends
# API_URL=http://127.0.0.1:8000

# Public API base URL embedded into the client bundle at build time.
# Leave empty to use relative paths (works when served from the same origin).
# Set to your full API URL for standalone / CDN deployments.
# NEXT_PUBLIC_API_URL=https://your-api.example.com
